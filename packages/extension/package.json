{
  "name": "remindoro",
  "version": "1.8.1",
  "description": "Better Reminders in browser",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "test": "vitest",
    "compress": "node scripts/compress",
    "compress-keygen": "crx keygen",
    "clean": "rimraf out/ build/ dev-server/ release/ dist/ extension/ *.zip *.crx",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "node_modules/typescript/bin/tsc --noEmit",
    "start:firefox": "bun run scripts/bun/dev.ts --browser=firefox",
    "start:chrome": "bun run scripts/bun/dev.ts --browser=chrome",
    "build:firefox": "bun run scripts/bun/prod.ts --browser=firefox",
    "build:chrome": "bun run scripts/bun/prod.ts --browser=chrome",
    "show:linked": "ls -l node_modules | grep ^l"
  },
  "keywords": [
    "Email Reminders",
    "time tracker",
    "chrome",
    "extension",
    "react",
    "redux",
    "firefox",
    "reminders",
    "browser reminders"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/palerdot/remindoro.git"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "^1.0.12",
    "@types/lodash": "^4.17.20",
    "@types/lodash-es": "^4.17.4",
    "@types/node": "^20.2.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^9.0.6",
    "@types/webextension-polyfill": "^0.12.4",
    "@types/yargs": "^17.0.34",
    "chalk": "5.3.0",
    "chrome-launch": "^1.1.4",
    "colors": "^1.3.3",
    "eslint-plugin-react": "^7.24.0",
    "execa": "^8.0.1",
    "gzip-size": "^7.0.0",
    "happy-dom": "^2.47.0",
    "lodash": "^4.17.23",
    "ora": "^8.0.1",
    "pretty-bytes": "^6.1.1",
    "prop-types": "^15.6.2",
    "react-dev-utils": "^12.0.1",
    "strip-json-comments": "^3.1.1",
    "typescript": "^5.0.4",
    "vite-tsconfig-paths": "^3.4.1",
    "vitest": "^0.6.1",
    "web-ext": "^9.2.0",
    "yargs": "^17.7.2",
    "zip-a-folder": "^1.1.0"
  },
  "dependencies": {
    "@date-io/dayjs": "^3.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@mui/utils": "7.3.5",
    "@mui/x-date-pickers": "8.19.0",
    "@reduxjs/toolkit": "^2.2.3",
    "dayjs": "^1.11.7",
    "lodash-es": "^4.17.21",
    "notistack": "^3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.1.1",
    "react-router-dom": "^7.9.6",
    "react-slite": "^0.4.2",
    "remindoro-utils": "^0.0.2",
    "tinybase": "^4.3.18",
    "uuid": "^9.0.1",
    "webextension-polyfill": "^0.12.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
